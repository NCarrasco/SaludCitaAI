# Copia este archivo a .env con:  ./scripts/bootstrap-env.sh
# El script genera valores aleatorios para los campos marcados <generar>.
# No subas .env a Git. Todos los datos de la demo son ficticios.

# --- Instancia ---
# Nombre del proyecto Docker Compose: separa contenedores y volúmenes. Cámbialo para levantar
# una segunda instancia (p. ej., una restauración de prueba) sin tocar la principal.
COMPOSE_PROJECT_NAME=saludcita

# --- PostgreSQL ---
POSTGRES_SUPERUSER_PASSWORD=<generar>
APP_DB_NAME=saludcita
APP_DB_USER=saludcita_app
APP_DB_PASSWORD=<generar>
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=<generar>
# Puerto publicado solo en 127.0.0.1 para pruebas locales
POSTGRES_HOST_PORT=55433

# --- API ---
API_HOST_PORT=8080
BUSINESS_TIMEZONE=America/Santo_Domingo
LOG_LEVEL=info
# Duración de una intención de reserva/cambio antes de caducar
INTENT_TTL_SECONDS=600
PATIENT_SESSION_TTL_HOURS=12
# Orígenes externos permitidos para CORS (el panel propio se sirve en el mismo origen y no lo necesita); separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Datos ficticios de la demo (solo cuentas de prueba) ---
# Contraseña común de las 20 cuentas ficticias de pacientes (paciente01..paciente20)
SEED_PATIENT_PASSWORD=<generar>

# --- n8n Community (autoalojado) ---
N8N_HOST_PORT=5678
# Clave de cifrado de credenciales de n8n: guárdala con el backup (sin ella no se recuperan credenciales)
N8N_ENCRYPTION_KEY=<generar>
# Secreto de la credencial de servicio que n8n usa contra la API (se envía como "Bearer svc_<valor>")
N8N_API_SERVICE_TOKEN=<generar>
# Secreto compartido entre la API y el webhook de conversación de n8n
N8N_WEBHOOK_SECRET=<generar>
N8N_CONVERSATION_WEBHOOK_URL=http://n8n:5678/webhook/saludcita-conversation
# Aviso a n8n de comandos nuevos (comprobantes, recordatorios); si falla, el workflow los recoge cada 30 s
N8N_COMMANDS_WEBHOOK_URL=http://n8n:5678/webhook/saludcita-commands

# --- Pasarela de Gradio (sesión invitada sin registro) ---
# Secreto de la credencial de servicio (scope gateway) con la que el servidor de Gradio crea sesiones invitadas
# y canjea códigos de recuperación. Nunca llega al navegador.
GRADIO_GATEWAY_TOKEN=<generar>
# Duración de la sesión invitada del dispositivo y del código de recuperación
GUEST_SESSION_TTL_DAYS=30
RECOVERY_CODE_TTL_DAYS=180
# Solo detrás de un proxy de confianza (Caddy): tomar la IP del cliente de X-Forwarded-For para los límites
GRADIO_TRUST_PROXY_HEADERS=false
# Limpieza diaria (comando durable): invitados vacíos y abandonados tras N días; sesiones caducadas se conservan N días
GUEST_ABANDONED_AFTER_DAYS=30
GUEST_SESSION_RETENTION_DAYS=7

# --- Modelo local (Ollama) ---
# Dentro de Compose: http://ollama:11434 · Ollama nativo en el anfitrión: http://host.docker.internal:11434
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:1.7b
# true/false para modelos con modo de razonamiento; vacío = no enviar el parámetro
OLLAMA_THINK=false
LLM_TIMEOUT_MS=45000
# Capa 1: conversación general generada por el modelo (segunda llamada vía n8n). Cada texto se valida; si no pasa,
# se usa el texto verificado. false = solo textos verificados.
LLM_CONVERSE_ENABLED=true
CONVERSATION_LEASE_SECONDS=120

# --- Gradio (interfaz del paciente) ---
GRADIO_HOST_PORT=7860
OLLAMA_HOST_PORT=11434

# --- Panel administrativo (/panel/) ---
# Contraseña común de los usuarios ficticios admin@, operador@ y panel@saludcita.test.
# Demostración académica: 12345678 (el login del panel llega rellenado con ella). Cámbiala si el sistema queda
# accesible desde internet; se aplica en el siguiente arranque (el servicio migrate actualiza la contraseña).
SEED_ADMIN_PASSWORD=12345678
ADMIN_SESSION_TTL_HOURS=8
# true en el despliegue con HTTPS; false solo en local (http)
COOKIE_SECURE=false

# --- Ofertas de adelanto ---
# Ventana normal de respuesta: 1 hora
OFFER_WINDOW_SECONDS=3600
# Modo demostración: ventana corta, registrada en cada ronda y visible en el aviso al paciente
OFFERS_DEMO_MODE=false
OFFER_DEMO_WINDOW_SECONDS=120

# Proveedor del modelo: ollama (local, por defecto) u openai (API compatible con OpenAI: Groq, OpenAI…).
# Con openai, n8n llama a la pasarela de la API y la clave SOLO vive aquí (nunca en n8n ni en el navegador).
LLM_PROVIDER=ollama
LLM_API_BASE=https://api.groq.com/openai/v1
LLM_API_MODEL=llama-3.3-70b-versatile
# Clave del proveedor: escríbela directamente en .env (no la pegues en chats ni la subas a Git)
LLM_API_KEY=
# Respaldo con openai: si el proveedor falla (límite diario, caída o lentitud), responde el modelo local OLLAMA_MODEL
# (perfil «ai»). Con 8 vCPU sin GPU, qwen3:1.7b responde en ~10–25 s. «none» lo desactiva.
LLM_FALLBACK=ollama
